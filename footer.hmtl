<footer>
    <div class="container beautiful-jekyll-footer">
        <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">

                {%- if site.social-network-links -%}
                <ul class="list-inline text-center footer-links">
                    {%- for link in site.social-network-links -%}
                        {%- assign curkey = link[0] -%}
                        {%- assign element = site.data.SocialNetworks[curkey] -%}
                        {%- if curkey == 'rss' -%}
                            <li>
                                <a href="{{ '/feed.xml' | relative_url }}" title="RSS">
                                    <span class="fa-stack fa-lg">
                                        <i class="fas fa-circle fa-stack-2x"></i>
                                        <i class="fas fa-rss fa-stack-1x fa-inverse"></i>
                                    </span>
                                </a>
                            </li>
                        {%- elsif curkey == 'email' -%}
                            <li>
                                <a href="mailto:{{ link[1] }}" title="Email me">
                                    <span class="fa-stack fa-lg">
                                        <i class="fas fa-circle fa-stack-2x"></i>
                                        <i class="fas fa-envelope fa-stack-1x fa-inverse"></i>
                                    </span>
                                </a>
                            </li>
                        {%- elsif element -%}
                            <li>
                                <a href="{{ element.url | replace: '%s', link[1] }}" title="{{ element.title }}">
                                    <span class="fa-stack fa-lg">
                                        <i class="fas fa-circle fa-stack-2x"></i>
                                        <i class="fab {{ element.icon }} fa-stack-1x fa-inverse"></i>
                                    </span>
                                </a>
                            </li>
                        {%- endif -%}
                    {%- endfor -%}
                </ul>
                {%- endif -%}

                <p class="copyright text-muted">
                    {{ site.author.name }} &copy; {{ site.time | date: '%Y' }}
                    &nbsp;&bull;&nbsp;
                    <a href="{{ site.url }}{{ site.baseurl }}">{{ site.title }}</a>
                </p>

                <!-- ===== PERIODWISE CUSTOM FOOTER ===== -->
                <div class="periodwise-footer">
                    <hr>

                    <p><strong>PeriodWise</strong> — Understand Your Cycle. Track Your Patterns. Know Your Body.</p>

                    <p>
                        <a href="{{ '/about/' | relative_url }}">About</a> |
                        <a href="{{ '/contact/' | relative_url }}">Contact</a> |
                        <a href="{{ '/privacy-policy/' | relative_url }}">Privacy Policy</a> |
                        <a href="{{ '/terms/' | relative_url }}">Terms &amp; Conditions</a> |
                        <a href="{{ '/medical-disclaimer/' | relative_url }}">Medical Disclaimer</a>
                    </p>

                    <p>
                        <a href="https://app.periodwise.online" target="_blank" rel="noopener noreferrer">Use the PeriodWise App</a> |
                        <a href="https://t.me/periodwise" target="_blank" rel="noopener noreferrer">Join Our Telegram Community</a>
                    </p>

                    <p>
                        Questions? Email
                        <a href="mailto:periodwise12@gmail.com">periodwise12@gmail.com</a>
                    </p>

                    <p>&copy; {{ site.time | date: "%Y" }} PeriodWise. All rights reserved.</p>
                </div>
                <!-- ===== END PERIODWISE CUSTOM FOOTER ===== -->

            </div>
        </div>
    </div>
</footer>
